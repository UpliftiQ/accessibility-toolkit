{
  "name": "upliftiq-accessibility-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Deaf-led, open-source React toolkit for caption-first, sign-language-ready digital experiences.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter @upliftiq/docs build",
    "build:packages": "pnpm --filter './packages/**' --workspace-concurrency=1 build",
    "dev": "pnpm --filter @upliftiq/docs dev",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --project accessibility",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.10.3",
    "jsdom": "^30.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
