{
  "name": "upliftiq-accessibility-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Deaf-led, open-source React toolkit for caption-first, sign-language-ready digital experiences.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter @upliftiq/docs build",
    "build:packages": "pnpm --filter './packages/**' --workspace-concurrency=1 build",
    "dev": "pnpm --filter @upliftiq/docs dev",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --project accessibility",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.10.3",
    "jsdom": "^27.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^9.1.10",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
