{
  "name": "@upliftiq/deaf-ui",
  "version": "0.1.0",
  "description": "Visual-first React components for alerts, progress and time-based states that do not depend on sound.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "keywords": ["accessibility", "deaf", "design-system", "react", "visual-alerts"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upliftiq/accessibility-toolkit.git",
    "directory": "packages/deaf-ui"
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  }
}
